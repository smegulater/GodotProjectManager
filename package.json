{
	"name": "godot-project-manager",
	"description": "A npm based Godot Project Manager - provides opinionated project setup and managemenet utilities ",
	"version": "0.1.0",
	"type": "module",
	"author": "George Chambers (smegulater)",
	"license": "MIT",
	"keywords": [
		"Godot",
		"Package",
		"Manager"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/smegulater/GodotProjectManager"
	},
	"main": "index.js",
	"scripts": {
		"dev": "ts-node src/index.ts",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"build": "tsc",
		"postbuild": "copyfiles -u 1 src/templates/**/* dist/",
		"postinstall": "node scripts/setup.js"
	},
	"bin": {
		"gpm": "./dist/index.js"
	},
	"dependencies": {
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"adm-zip": "^0.5.16",
		"chalk": "^5.6.2",
		"commander": "^14.0.1",
		"execa": "^9.6.0",
		"fs-extra": "^11.3.2",
		"ini": "^5.0.0",
		"inquirer": "^12.10.0",
		"node-fetch": "^3.3.2",
		"ora": "^9.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.38.0",
		"@types/adm-zip": "^0.5.7",
		"@types/chalk": "^0.4.31",
		"@types/commander": "^2.12.0",
		"@types/fs-extra": "^11.0.4",
		"@types/ini": "^4.1.1",
		"@types/inquirer": "^9.0.9",
		"@types/node": "^24.8.1",
		"@types/node-fetch": "^2.6.13",
		"copyfiles": "^2.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	}
}
