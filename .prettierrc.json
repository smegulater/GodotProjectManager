{
	"useTabs": true,
	"tabWidth": 1,
	"printWidth": 120,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"overrides": [
		{
			"files": ["*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2,
				"singleQuote": false,
				"trailingComma": "none",
				"bracketSpacing": false
			}
		}
	]
}
